server {
    listen 80;
    listen [::]:80;
    server_name weiss.zzzping.top;
    server_tokens off;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/letsencrypt;
        try_files $uri =404;
    }

    location / {
        return 301 https://weiss.zzzping.top$request_uri;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name weiss.zzzping.top;

    ssl_certificate /etc/letsencrypt/live/weiss.zzzping.top/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/weiss.zzzping.top/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    root /var/www/weiss.zzzping.top/current;
    index book_overview.html;
    autoindex off;
    server_tokens off;
    charset utf-8;

    access_log /var/log/nginx/weiss.zzzping.top.access.log;
    error_log /var/log/nginx/weiss.zzzping.top.error.log;

    @@ACCESS_POLICY@@

    add_header Cache-Control "@@CACHE_POLICY@@" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' @@SCRIPT_SOURCES@@; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'" always;

    location ^~ /.well-known/acme-challenge/ {
        auth_basic off;
        root /var/www/letsencrypt;
        try_files $uri =404;
    }

    location ~ (^|/)\. {
        return 404;
    }

    location = /tools/check_notes.py {
        default_type application/octet-stream;
        limit_except GET HEAD { deny all; }
        try_files $uri =404;
    }

    location / {
        limit_except GET HEAD { deny all; }
        try_files $uri $uri/ =404;
    }
}
