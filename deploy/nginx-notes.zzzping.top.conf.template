server {
    listen 80;
    listen [::]:80;
    server_name notes.zzzping.top;
    server_tokens off;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/letsencrypt;
        try_files $uri =404;
    }
    location / {
        return 301 https://notes.zzzping.top$request_uri;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name notes.zzzping.top;
    ssl_certificate /etc/letsencrypt/live/notes.zzzping.top/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/notes.zzzping.top/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    access_log /var/log/nginx/notes.zzzping.top.access.log;
    error_log /var/log/nginx/notes.zzzping.top.error.log;
    include /var/lib/notes-deploy/@@RELEASE_ID@@/nginx-static.inc;
}
