[Unit]
Description=Publish a checked immutable Reading Notes release
After=nginx.service
Requires=nginx.service

[Service]
Type=oneshot
User=reading-notes
Group=reading-notes
ExecStart=/usr/local/lib/reading-notes/deploy/scripts/deploy-job.py
UMask=0022
TimeoutStartSec=15min
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
# nginx -t opens its existing PID file even when only validating configuration.
# Keep the exception at this root-owned file; the publisher still cannot write it.
ReadWritePaths=/srv/reading-notes /var/spool/reading-notes /run/nginx.pid
StandardOutput=journal
StandardError=journal
# Filesystem ownership keeps the service user out of /srv; the fixed sudo installer writes it.
# Nginx validation runs in a fixed transient root unit, outside this unit's read-only log mount.
# NoNewPrivileges is omitted for the fixed sudo installer.
