---
import ControlledContent from '../components/ControlledContent.astro';
import { parse } from 'parse5';
import { walk } from '../lib/controlled-html.mjs';
const { html, island = '' } = Astro.props;
const nodes = walk(parse(html, { sourceCodeLocationInfo: true }));
const document = nodes.find(n => n.tagName === 'html');
const head = nodes.find(n => n.tagName === 'head');
const body = nodes.find(n => n.tagName === 'body');
if (!document || !head?.sourceCodeLocation || !body?.sourceCodeLocation) throw new Error('Incomplete reading document');
const attributes = node => Object.fromEntries(node.attrs.map(a => [a.name, a.value]));
const inner = node => html.slice(node.sourceCodeLocation.startTag.endOffset, node.sourceCodeLocation.endTag.startOffset);
---
<!doctype html><html {...attributes(document)}><head {...attributes(head)}><Fragment set:html={inner(head)} /></head><body {...attributes(body)}><ControlledContent html={inner(body)} /><Fragment set:html={island} /></body></html>
